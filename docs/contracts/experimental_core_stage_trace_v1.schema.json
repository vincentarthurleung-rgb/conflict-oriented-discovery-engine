  "required": [
    "trace_id",
    "source_observation_identity",
    "stage_number",
    "stage_name",
    "stage_identity",
    "factor_count",
    "intervention_count",
    "measurement_count",
    "observed_result_count",
    "linkage_count",
    "evidence_count",
    "field_availability",
    "field_status",
