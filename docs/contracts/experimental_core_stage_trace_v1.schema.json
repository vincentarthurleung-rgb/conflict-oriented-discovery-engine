          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "offline": {
          "const": true,
          "default": true,
          "title": "Offline",
          "type": "boolean"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "title": "Producer Version",
          "type": "string"
        },
        "source_artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Artifact Refs",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "producer_version"
      ],
      "title": "CoreProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence_count": {
      "title": "Evidence Count",
      "type": "integer"
    },
    "factor_count": {
      "title": "Factor Count",
      "type": "integer"
    },
    "field_availability": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Field Availability",
      "type": "object"
    },
    "field_status": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Field Status",
      "type": "object"
    },
    "identity": {
      "title": "Identity",
      "type": "string"
    },
    "intervention_count": {
      "title": "Intervention Count",
      "type": "integer"
    },
    "linkage_count": {
      "title": "Linkage Count",
      "type": "integer"
    },
    "measurement_count": {
      "title": "Measurement Count",
      "type": "integer"
    },
    "observed_result_count": {
      "title": "Observed Result Count",
      "type": "integer"
    },
    "payload_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
