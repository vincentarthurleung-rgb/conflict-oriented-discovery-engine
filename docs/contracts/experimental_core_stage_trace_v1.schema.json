    },
    "source_observation_identity": {
      "title": "Source Observation Identity",
      "type": "string"
    },
    "stage_identity": {
      "title": "Stage Identity",
      "type": "string"
    },
    "stage_name": {
      "title": "Stage Name",
      "type": "string"
    },
    "stage_number": {
      "title": "Stage Number",
      "type": "integer"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    }
