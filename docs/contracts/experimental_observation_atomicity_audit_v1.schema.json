{
  "$defs": {
    "CoreProvenance": {
      "additionalProperties": false,
      "properties": {
        "deterministic_rule_refs": {
          "items": {
            "type": "string"
          },
          "title": "Deterministic Rule Refs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "offline": {
          "const": true,
          "default": true,
          "title": "Offline",
          "type": "boolean"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "title": "Producer Version",
          "type": "string"
        },
        "source_artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Artifact Refs",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "producer_version"
      ],
      "title": "CoreProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "child_revision_ids": {
      "items": {
        "type": "string"
      },
      "title": "Child Revision Ids",
      "type": "array"
    },
    "deterministic_split_allowed": {
      "default": false,
      "title": "Deterministic Split Allowed",
      "type": "boolean"
    },
    "identity": {
      "title": "Identity",
      "type": "string"
    },
    "issue_codes": {
      "items": {
        "type": "string"
      },
      "title": "Issue Codes",
      "type": "array"
    },
    "parent_observation_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Observation Identity"
    },
    "provenance": {
      "$ref": "#/$defs/CoreProvenance"
    },
    "schema_version": {
      "const": "experimental_observation_atomicity_audit_v1",
      "default": "experimental_observation_atomicity_audit_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_observation_identity": {
      "title": "Source Observation Identity",
      "type": "string"
    },
    "status": {
      "enum": [
        "atomic",
        "compound_but_explicitly_linked",
        "merged_recoverable",
        "merged_unrecoverable",
        "unresolved"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "source_observation_identity",
    "status",
    "identity",
    "provenance"
  ],
  "title": "ExperimentalObservationAtomicityAudit",
  "type": "object"
