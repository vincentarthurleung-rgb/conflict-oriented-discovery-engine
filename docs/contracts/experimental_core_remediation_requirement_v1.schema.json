{
  "$defs": {
    "CoreProvenance": {
      "additionalProperties": false,
      "properties": {
        "deterministic_rule_refs": {
          "items": {
            "type": "string"
          },
          "title": "Deterministic Rule Refs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "offline": {
          "const": true,
          "default": true,
          "title": "Offline",
          "type": "boolean"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "title": "Producer Version",
          "type": "string"
        },
        "source_artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Artifact Refs",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "producer_version"
      ],
      "title": "CoreProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "automatic_execution_authorized": {
      "const": false,
      "default": false,
      "title": "Automatic Execution Authorized",
      "type": "boolean"
    },
    "available_offline_recovery_modes": {
      "items": {
        "type": "string"
      },
      "title": "Available Offline Recovery Modes",
      "type": "array"
    },
    "budget_authorization_present": {
      "const": false,
      "default": false,
      "title": "Budget Authorization Present",
      "type": "boolean"
    },
    "dedup_group_identity": {
      "title": "Dedup Group Identity",
      "type": "string"
    },
    "evidence_status": {
      "title": "Evidence Status",
      "type": "string"
    },
    "first_loss_stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Loss Stage"
    },
    "identity": {
      "title": "Identity",
      "type": "string"
    },
    "minimal_source_scope": {
      "title": "Minimal Source Scope",
      "type": "string"
    },
    "missing_components": {
      "items": {
        "type": "string"
      },
      "title": "Missing Components",
      "type": "array"
    },
    "network_call_authorized": {
      "const": false,
      "default": false,
      "title": "Network Call Authorized",
      "type": "boolean"
    },
    "observation_identity": {
      "title": "Observation Identity",
      "type": "string"
    },
    "observation_type": {
      "enum": [
        "interventional_experiment",
        "observational_comparison",
        "descriptive_measurement",
        "non_experimental_claim",
        "unresolved"
      ],
      "title": "Observation Type",
      "type": "string"
    },
    "parsed_payload_status": {
      "title": "Parsed Payload Status",
      "type": "string"
    },
    "preferred_offline_recovery_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preferred Offline Recovery Mode"
    },
    "provenance": {
      "$ref": "#/$defs/CoreProvenance"
    },
    "provider_call_authorized": {
      "const": false,
      "default": false,
      "title": "Provider Call Authorized",
      "type": "boolean"
    },
    "provider_reextraction_required": {
      "title": "Provider Reextraction Required",
      "type": "boolean"
    },
    "raw_lineage_status": {
      "title": "Raw Lineage Status",
      "type": "string"
    },
    "schema_version": {
      "const": "experimental_core_remediation_requirement_v1",
      "default": "experimental_core_remediation_requirement_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_block_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Block Identity"
    }
  },
  "required": [
    "observation_identity",
    "observation_type",
    "missing_components",
    "raw_lineage_status",
    "parsed_payload_status",
    "evidence_status",
    "provider_reextraction_required",
    "minimal_source_scope",
    "dedup_group_identity",
    "identity",
    "provenance"
  ],
  "title": "ExperimentalCoreRemediationRequirement",
  "type": "object"
}
