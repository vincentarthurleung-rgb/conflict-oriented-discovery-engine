      "type": "string"
    },
    "evidence_anchor_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Anchor Ids",
      "type": "array"
    },
    "identity": {
      "title": "Identity",
      "type": "string"
    },
    "local_measurement_id": {
      "title": "Local Measurement Id",
      "type": "string"
    },
    "localization_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Localization Ref"
    },
    "measured_entity_canonical": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measured Entity Canonical"
    },
    "measured_entity_extracted": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measured Entity Extracted"
    },
    "measured_entity_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measured Entity Raw"
    },
    "measurement_id": {
      "title": "Measurement Id",
      "type": "string"
    },
    "measurement_semantic_level": {
      "title": "Measurement Semantic Level",
      "type": "string"
    },
    "method_canonical": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method Canonical"
    },
    "method_extracted": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method Extracted"
    },
    "method_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method Raw"
    },
    "normalization_status": {
      "title": "Normalization Status",
      "type": "string"
    },
    "observation_revision_identity": {
      "title": "Observation Revision Identity",
      "type": "string"
    },
    "property_or_endpoint_canonical": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Property Or Endpoint Canonical"
    },
    "property_or_endpoint_extracted": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Property Or Endpoint Extracted"
    },
    "property_or_endpoint_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Property Or Endpoint Raw"
    },
    "provenance": {
      "$ref": "#/$defs/CoreProvenance"
