  "required": [
    "measurement_id",
    "observation_revision_identity",
    "local_measurement_id",
    "measurement_semantic_level",
    "validation_status",
    "normalization_status",
    "authority_status",
    "identity",
    "provenance"
  ],
  "title": "MeasurementRecord",
  "type": "object"
}
