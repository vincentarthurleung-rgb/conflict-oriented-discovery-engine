    "sample_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample Ref"
    },
    "schema_version": {
      "const": "measurement_record_v1",
      "default": "measurement_record_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "unit_canonical": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit Canonical"
    },
    "unit_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit Raw"
    },
    "validation_status": {
      "title": "Validation Status",
      "type": "string"
    }
