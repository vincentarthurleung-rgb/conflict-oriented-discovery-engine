{
  "$defs": {
    "CoreProvenance": {
      "additionalProperties": false,
      "properties": {
        "deterministic_rule_refs": {
          "items": {
            "type": "string"
          },
          "title": "Deterministic Rule Refs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "offline": {
          "const": true,
          "default": true,
          "title": "Offline",
          "type": "boolean"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "title": "Producer Version",
          "type": "string"
        },
        "source_artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Artifact Refs",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "producer_version"
      ],
      "title": "CoreProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority_status": {
      "enum": [
        "authoritative",
        "deterministic",
        "candidate_only",
        "unresolved",
        "blocked"
      ],
      "title": "Authority Status",
      "type": "string"
    },
    "baseline_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Ref"
    },
    "comparison_factor_refs": {
      "items": {
        "type": "string"
      },
      "title": "Comparison Factor Refs",
      "type": "array"
    },
    "confidence_interval": {
      "default": null,
      "title": "Confidence Interval"
    },
    "direction": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Direction"
    },
    "effect_size": {
      "default": null,
      "title": "Effect Size"
    },
    "evidence_anchor_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Anchor Ids",
      "type": "array"
    },
    "identity": {
      "title": "Identity",
      "type": "string"
    },
    "local_result_id": {
      "title": "Local Result Id",
      "type": "string"
    },
    "measurement_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurement Ref"
    },
    "negation": {
      "default": false,
      "title": "Negation",
      "type": "boolean"
    },
    "observation_revision_identity": {
      "title": "Observation Revision Identity",
      "type": "string"
    },
    "observed_result_id": {
      "title": "Observed Result Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/CoreProvenance"
    },
    "qualitative_result": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qualitative Result"
    },
    "quantitative_value_canonical": {
      "default": null,
      "title": "Quantitative Value Canonical"
    },
    "quantitative_value_raw": {
      "default": null,
      "title": "Quantitative Value Raw"
    },
    "schema_version": {
      "const": "observed_result_record_v1",
      "default": "observed_result_record_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sign": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sign"
    },
    "significance_status": {
      "title": "Significance Status",
      "type": "string"
    },
    "statistical_statement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Statistical Statement"
    },
    "uncertainty_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty Text"
    },
    "validation_status": {
      "title": "Validation Status",
      "type": "string"
    }
  },
  "required": [
    "observed_result_id",
    "observation_revision_identity",
    "local_result_id",
    "significance_status",
    "validation_status",
    "authority_status",
    "identity",
    "provenance"
  ],
  "title": "ObservedResultRecord",
  "type": "object"
}
