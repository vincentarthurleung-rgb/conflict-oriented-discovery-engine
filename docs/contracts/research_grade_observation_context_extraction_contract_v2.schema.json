{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "experiment_scopes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "scope_local_id": {
            "type": "string"
          },
          "shared_context": {
            "type": "object"
          }
        },
        "required": [
          "scope_local_id",
          "shared_context"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "observations": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "observation_type_candidate": {
                  "enum": [
                    "interventional_experiment",
                    "observational_comparison",
                    "descriptive_measurement"
                  ]
                }
              },
              "required": [
                "observation_type_candidate"
              ]
            },
            "then": {
              "properties": {
                "measurements": {
                  "minItems": 1
                },
                "observed_results": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "observation_type_candidate": {
                  "enum": [
                    "interventional_experiment",
                    "observational_comparison"
                  ]
                }
              },
              "required": [
                "observation_type_candidate"
              ]
            },
            "then": {
              "properties": {
                "experimental_factors": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "properties": {
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "experiment_scope_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "experimental_factors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "evidence_refs": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "factor_local_id": {
                  "type": "string"
                },
                "order": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "raw_text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "role": {
                  "type": "string"
                }
              },
              "required": [
                "factor_local_id",
                "role",
                "raw_text",
                "evidence_refs"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "local_context": {
            "type": "object"
          },
          "measurements": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "endpoint_raw": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence_refs": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "measurement_local_id": {
                  "type": "string"
                },
                "method_raw": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "target_raw": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "measurement_local_id",
                "target_raw",
                "endpoint_raw",
                "method_raw",
                "evidence_refs"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "observation_local_id": {
            "type": "string"
          },
          "observation_type_candidate": {
            "enum": [
              "interventional_experiment",
              "observational_comparison",
              "descriptive_measurement",
              "non_experimental_claim",
              "unresolved"
            ]
          },
          "observed_results": {
            "items": {
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "comparison_status": {
                        "const": "comparative"
                      }
                    },
                    "required": [
                      "comparison_status"
                    ]
                  },
                  "then": {
                    "anyOf": [
                      {
                        "properties": {
                          "comparison_factor_refs": {
                            "minItems": 1
                          }
                        }
                      },
                      {
                        "properties": {
                          "baseline_ref": {
                            "minLength": 1,
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              ],
              "properties": {
                "baseline_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "comparison_factor_refs": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "comparison_status": {
                  "enum": [
                    "comparative",
                    "non_comparative",
                    "unresolved"
                  ]
                },
                "direction": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence_refs": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "measurement_ref": {
                  "type": "string"
                },
                "qualitative_result": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "result_local_id": {
                  "type": "string"
                }
              },
              "required": [
                "result_local_id",
                "measurement_ref",
                "comparison_status",
                "comparison_factor_refs",
                "baseline_ref",
                "qualitative_result",
                "evidence_refs"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "observation_local_id",
          "observation_type_candidate",
          "experiment_scope_ref",
          "experimental_factors",
          "measurements",
          "observed_results",
          "local_context",
          "evidence_refs"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "experiment_scopes",
    "observations"
  ],
  "title": "research_grade_observation_context_extraction_contract_v2",
  "type": "object"
}
