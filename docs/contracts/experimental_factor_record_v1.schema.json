{
  "$defs": {
    "CoreProvenance": {
      "additionalProperties": false,
      "properties": {
        "deterministic_rule_refs": {
          "items": {
            "type": "string"
          },
          "title": "Deterministic Rule Refs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "offline": {
          "const": true,
          "default": true,
          "title": "Offline",
          "type": "boolean"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "title": "Producer Version",
          "type": "string"
        },
        "source_artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Artifact Refs",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "producer_version"
      ],
      "title": "CoreProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority_status": {
      "enum": [
        "authoritative",
        "deterministic",
        "candidate_only",
        "unresolved",
        "blocked"
      ],
      "title": "Authority Status",
      "type": "string"
    },
    "canonical_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Identity"
    },
    "canonical_value": {
      "default": null,
      "title": "Canonical Value"
    },
    "context_field_refs": {
      "items": {
        "type": "string"
      },
      "title": "Context Field Refs",
      "type": "array"
    },
    "control_or_comparator_status": {
      "title": "Control Or Comparator Status",
      "type": "string"
    },
    "evidence_anchor_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Anchor Ids",
      "type": "array"
    },
    "extracted_value": {
      "default": null,
      "title": "Extracted Value"
    },
    "factor_group_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Factor Group Id"
    },
    "factor_id": {
      "title": "Factor Id",
      "type": "string"
    },
    "identity": {
      "title": "Identity",
      "type": "string"
    },
    "local_factor_id": {
      "title": "Local Factor Id",
      "type": "string"
    },
    "normalization_status": {
      "title": "Normalization Status",
      "type": "string"
    },
    "observation_revision_identity": {
      "title": "Observation Revision Identity",
      "type": "string"
    },
    "order_index": {
      "title": "Order Index",
      "type": "integer"
    },
    "provenance": {
      "$ref": "#/$defs/CoreProvenance"
    },
    "qualifier_refs": {
      "items": {
        "type": "string"
      },
      "title": "Qualifier Refs",
      "type": "array"
    },
    "raw_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Text"
    },
    "role": {
      "enum": [
        "intervention",
        "treatment",
        "exposure",
        "genetic_manipulation",
        "environmental_condition",
        "disease_condition",
        "cohort",
        "experimental_group",
        "control",
        "comparator",
        "baseline",
        "sample_condition",
        "unresolved"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": "experimental_factor_record_v1",
      "default": "experimental_factor_record_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "validation_status": {
      "title": "Validation Status",
      "type": "string"
    },
    "value_state": {
      "title": "Value State",
      "type": "string"
    }
  },
  "required": [
    "factor_id",
    "observation_revision_identity",
    "local_factor_id",
    "role",
    "value_state",
    "order_index",
    "control_or_comparator_status",
    "validation_status",
    "normalization_status",
    "authority_status",
    "identity",
    "provenance"
  ],
  "title": "ExperimentalFactorRecord",
  "type": "object"
}
