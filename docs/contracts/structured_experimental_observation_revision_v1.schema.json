{
  "$defs": {
    "CoreProvenance": {
      "additionalProperties": false,
      "properties": {
        "deterministic_rule_refs": {
          "items": {
            "type": "string"
          },
          "title": "Deterministic Rule Refs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "offline": {
          "const": true,
          "default": true,
          "title": "Offline",
          "type": "boolean"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "title": "Producer Version",
          "type": "string"
        },
        "source_artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Artifact Refs",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "producer_version"
      ],
      "title": "CoreProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "context_asset_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Asset Identity"
    },
    "evidence_chain_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Chain Identity"
    },
    "experiment_scope_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experiment Scope Identity"
    },
    "experimental_factor_ids": {
      "items": {
        "type": "string"
      },
      "title": "Experimental Factor Ids",
      "type": "array"
    },
    "extraction_schema_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extraction Schema Identity"
    },
    "identity": {
      "title": "Identity",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "linkage_record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Linkage Record Ids",
      "type": "array"
    },
    "measurement_ids": {
      "items": {
        "type": "string"
      },
      "title": "Measurement Ids",
      "type": "array"
    },
    "observation_type": {
      "enum": [
        "interventional_experiment",
        "observational_comparison",
        "descriptive_measurement",
        "non_experimental_claim",
        "unresolved"
      ],
      "title": "Observation Type",
      "type": "string"
    },
    "observation_type_authority": {
      "enum": [
        "authoritative",
        "deterministic",
        "candidate_only",
        "unresolved",
        "blocked"
      ],
      "title": "Observation Type Authority",
      "type": "string"
    },
    "observed_result_ids": {
      "items": {
        "type": "string"
      },
      "title": "Observed Result Ids",
      "type": "array"
    },
    "parser_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parser Identity"
    },
    "provenance": {
      "$ref": "#/$defs/CoreProvenance"
    },
    "schema_version": {
      "const": "structured_experimental_observation_revision_v1",
      "default": "structured_experimental_observation_revision_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_fulltext_v3_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Fulltext V3 Identity"
    },
    "source_observation_identity": {
      "title": "Source Observation Identity",
      "type": "string"
    },
    "source_parsed_candidate_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Parsed Candidate Identity"
    },
    "source_projection_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Projection Identity"
    },
    "source_validated_observation_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Validated Observation Identity"
    },
    "structural_integrity_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Structural Integrity Identity"
    },
    "structured_observation_revision_id": {
      "title": "Structured Observation Revision Id",
      "type": "string"
    },
    "supersedes_revision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Revision Id"
    },
    "validator_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validator Identity"
    }
  },
  "required": [
    "structured_observation_revision_id",
    "source_observation_identity",
    "observation_type",
    "observation_type_authority",
    "identity",
    "provenance"
  ],
  "title": "StructuredExperimentalObservationRevision",
  "type": "object"
}
