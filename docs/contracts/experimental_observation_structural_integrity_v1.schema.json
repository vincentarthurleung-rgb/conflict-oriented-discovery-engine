    "source_observation_identity": {
      "title": "Source Observation Identity",
      "type": "string"
    },
    "status": {
      "enum": [
        "structurally_complete",
        "structurally_complete_with_limitations",
        "incomplete_missing_factor",
        "incomplete_missing_measurement",
        "incomplete_missing_result",
        "incomplete_missing_linkage",
        "invalid_dangling_reference",
        "non_experimental_claim",
        "unresolved"
      ],
      "title": "Status",
      "type": "string"
    },
    "structured_observation_revision_identity": {
      "title": "Structured Observation Revision Identity",
      "type": "string"
    }
  },
  "required": [
    "source_observation_identity",
    "structured_observation_revision_identity",
    "observation_type",
    "status",
    "factor_requirement_basis",
    "core_evidence_complete",
    "provenance_traceable",
    "identity",
    "provenance"
  ],
