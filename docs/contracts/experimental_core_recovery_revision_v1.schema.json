  "required": [
    "recovery_revision_id",
    "source_observation_identity",
    "affected_component",
    "source_stage",
    "source_artifact_identity",
    "old_status",
    "recovery_method",
    "deterministic_rule_identity",
    "authority_status",
    "identity",
    "provenance"
  ],
  "title": "ExperimentalCoreRecoveryRevision",
  "type": "object"
}
