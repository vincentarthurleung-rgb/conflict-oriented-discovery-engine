{
  "$defs": {
    "CoreProvenance": {
      "additionalProperties": false,
      "properties": {
        "deterministic_rule_refs": {
          "items": {
            "type": "string"
          },
          "title": "Deterministic Rule Refs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "offline": {
          "const": true,
          "default": true,
          "title": "Offline",
          "type": "boolean"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "title": "Producer Version",
          "type": "string"
        },
        "source_artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Artifact Refs",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "producer_version"
      ],
      "title": "CoreProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "component": {
      "enum": [
        "experimental_factors",
        "interventions",
        "measurements",
        "observed_results",
        "linkages"
      ],
      "title": "Component",
      "type": "string"
    },
    "diagnosis_id": {
      "title": "Diagnosis Id",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "first_loss_stage_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Loss Stage Name"
    },
    "first_loss_stage_number": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Loss Stage Number"
    },
    "identity": {
      "title": "Identity",
      "type": "string"
    },
    "loss_origin": {
      "enum": [
        "present_all_stages",
        "absent_from_provider_output",
        "raw_unavailable",
        "parser_dropped",
        "response_schema_could_not_represent",
        "adapter_dropped",
        "schema_validation_rejected",
        "scientific_validation_rejected",
        "atomization_split_loss",
        "experiment_merge_loss",
        "local_id_reference_loss",
        "fulltext_v3_projection_loss",
        "evidence_projection_loss",
        "asset_migration_omission",
        "non_experimental_source",
        "legacy_lineage_unavailable",
        "unknown"
      ],
      "title": "Loss Origin",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/CoreProvenance"
    },
    "schema_version": {
      "const": "experimental_core_first_loss_diagnosis_v1",
      "default": "experimental_core_first_loss_diagnosis_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_observation_identity": {
      "title": "Source Observation Identity",
      "type": "string"
    },
    "stage_trace_ids": {
      "items": {
        "type": "string"
      },
      "title": "Stage Trace Ids",
      "type": "array"
    }
  },
  "required": [
    "diagnosis_id",
    "source_observation_identity",
    "component",
    "loss_origin",
    "stage_trace_ids",
    "identity",
    "provenance"
  ],
  "title": "ExperimentalCoreFirstLossDiagnosis",
  "type": "object"
}
