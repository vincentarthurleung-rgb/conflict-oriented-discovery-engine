{
  "$defs": {
    "AssetProvenance": {
      "additionalProperties": false,
      "properties": {
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "offline": {
          "const": true,
          "default": true,
          "title": "Offline",
          "type": "boolean"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "title": "Producer Version",
          "type": "string"
        },
        "source_artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Artifact Refs",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "producer_version"
      ],
      "title": "AssetProvenance",
      "type": "object"
    },
    "ConsolidationFieldResolution": {
      "additionalProperties": false,
      "properties": {
        "authority_status": {
          "title": "Authority Status",
          "type": "string"
        },
        "candidate_value_records": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Value Records",
          "type": "array"
        },
        "conflict_status": {
          "enum": [
            "clear",
            "conflict",
            "unresolved"
          ],
          "title": "Conflict Status",
          "type": "string"
        },
        "direct_vs_inherited": {
          "enum": [
            "direct",
            "inherited",
            "unresolved"
          ],
          "title": "Direct Vs Inherited",
          "type": "string"
        },
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "rejection_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Rejection Reasons",
          "type": "array"
        },
        "resolution_method": {
          "enum": [
            "validated_direct_local",
            "validated_same_observation",
            "validated_scope_inheritance",
            "historical_validated_consolidation",
            "unresolved"
          ],
          "title": "Resolution Method",
          "type": "string"
        },
        "selected_value_record": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Value Record"
        }
      },
      "required": [
        "field_id",
        "selected_value_record",
        "resolution_method",
        "direct_vs_inherited",
        "conflict_status",
        "authority_status"
      ],
      "title": "ConsolidationFieldResolution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority_status": {
      "title": "Authority Status",
      "type": "string"
    },
    "conflicting_field_count": {
      "minimum": 0,
      "title": "Conflicting Field Count",
      "type": "integer"
    },
    "consolidation_policy_identity": {
      "title": "Consolidation Policy Identity",
      "type": "string"
    },
    "consolidation_revision_id": {
      "title": "Consolidation Revision Id",
      "type": "string"
    },
    "direct_field_count": {
      "minimum": 0,
      "title": "Direct Field Count",
      "type": "integer"
    },
    "experiment_scope_ids": {
      "items": {
        "type": "string"
      },
      "title": "Experiment Scope Ids",
      "type": "array"
    },
    "field_resolution_records": {
      "items": {
        "$ref": "#/$defs/ConsolidationFieldResolution"
      },
      "title": "Field Resolution Records",
      "type": "array"
    },
    "identity": {
      "title": "Identity",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "inherited_field_count": {
      "minimum": 0,
      "title": "Inherited Field Count",
      "type": "integer"
    },
    "observation_identity": {
      "title": "Observation Identity",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/AssetProvenance"
    },
    "schema_version": {
      "const": "context_consolidation_revision_v1",
      "default": "context_consolidation_revision_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_context_candidate_revisions": {
      "items": {
        "type": "string"
      },
      "title": "Source Context Candidate Revisions",
      "type": "array"
    },
    "unavailable_field_count": {
      "minimum": 0,
      "title": "Unavailable Field Count",
      "type": "integer"
    },
    "unresolved_field_count": {
      "minimum": 0,
      "title": "Unresolved Field Count",
      "type": "integer"
    },
    "validated_context_revision_ids": {
      "items": {
        "type": "string"
      },
      "title": "Validated Context Revision Ids",
      "type": "array"
    }
  },
  "required": [
    "consolidation_revision_id",
    "observation_identity",
    "direct_field_count",
    "inherited_field_count",
    "unresolved_field_count",
    "unavailable_field_count",
    "conflicting_field_count",
    "consolidation_policy_identity",
    "authority_status",
    "identity",
    "provenance"
  ],
  "title": "ContextConsolidationRevision",
  "type": "object"
}
